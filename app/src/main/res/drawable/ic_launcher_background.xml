<?xml version="1.0" encoding="utf-8"?>
<!--
    Brainzo Match Adaptive Launcher Icon Background Vector
    Target Path: app/src/main/res/drawable/ic_launcher_background.xml
    Format: Android Vector Drawable (108dp x 108dp)
    Color: Brainzo Purple Brand Base (#7C3AED / #5B21B6) with subtle radial tonal depth
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid Base Layer using primary Brainzo Purple -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Subtle darker purple bottom-right gradient accent to provide 3D depth -->
    <path
        android:fillAlpha="0.25"
        android:fillColor="#4C1D95"
        android:pathData="M0,72 L72,0 L108,0 L108,108 L0,108 Z" />

    <!-- Soft playful circular radial highlights in background -->
    <path
        android:fillAlpha="0.12"
        android:fillColor="#EDE9FE"
        android:pathData="M54,20 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0" />

    <path
        android:fillAlpha="0.08"
        android:fillColor="#FFFFFF"
        android:pathData="M88,80 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />

</vector>
