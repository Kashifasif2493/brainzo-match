<?xml version="1.0" encoding="utf-8"?>
<!--
    Brainzo Match Master Application Manifest
    Target Path: app/src/main/AndroidManifest.xml
    Package: com.brainzomatch.app
    Target SDK: 36 (Android 16) | Min SDK: 24 (Android 7.0)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.brainzomatch.app">

    <!-- =================================================================== -->
    <!-- PERMISSIONS: Restricted strictly to verified codebase features      -->
    <!-- =================================================================== -->

    <!-- Required for AdMob ad requests and Google Play Billing network verification -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required by BrainzoAudioManager (VibratorManager / Vibrator) for sensory tactile haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required by BillingManager for Google Play In-App Billing v6 (VIP Gold Pass subscription) -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Note: AD_ID permission is intentionally NOT declared to ensure strict COPPA & Google Play Families Policy compliance -->

    <application
        android:name=".BrainzoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainzoMatch"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules_legacy"
        tools:targetApi="36">

        <!-- =============================================================== -->
        <!-- ADMOB METADATA: Official Google Sample App ID for development    -->
        <!-- =============================================================== -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Disable AdMob automatic app measurement to strictly follow COPPA Families Guidelines -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.INTEGRATION_CHECK"
            android:value="true" />

        <!-- AdMob Performance Optimization Flags -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />

        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- =============================================================== -->
        <!-- MAIN ACTIVITY & LAUNCHER DECLARATION                            -->
        <!-- =============================================================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.BrainzoMatch.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
